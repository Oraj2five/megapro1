# Environment: "development" or "production"
ENVIRONMENT=development

# Development-only flag: set to true ONLY for local debugging when Firebase service account is not yet configured.
# NOTE: This flag is STRICTLY IGNORED whenever ENVIRONMENT=production.
ALLOW_UNVERIFIED_DEV_MODE=false

# Firebase Admin Service Account Credentials (Required for production authentication and Firestore ownership checks)
# Option 1: Path to service account JSON key file
FIREBASE_CREDENTIALS_PATH=

# Option 2: Individual environment variables
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Supabase Server Configuration (Optional: only needed if backend reads directly from private storage)
SUPABASE_URL=https://dzwzsnnrfstsmtpueilo.supabase.co
